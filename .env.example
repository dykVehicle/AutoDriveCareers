# API配置
# 如果需要使用服务器端存储用户数据，请配置以下API地址
# 留空或设置为 "disabled" 将使用本地 localStorage 存储
VITE_API_BASE_URL=

# 开发环境示例
# VITE_API_BASE_URL=http://localhost:3000/api

# 生产环境示例
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# EmailJS配置（用于发送真实验证码邮件）
# 访问 https://www.emailjs.com/ 注册并获取配置信息
# 如果不配置，验证码将仅在前端生成（开发模式）
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
